{
  "name": "unitik-cob",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web integrador OSS/BSS para UNITIK Internet Sin Límite S.A.S. — Gobernanza de TI ISO/IEC 38500 (Trabajo de Grado, Universidad Cooperativa de Colombia)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:migrate": "pnpm --filter @unitik/api prisma:migrate",
    "prisma:seed": "pnpm --filter @unitik/api prisma:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3"
  }
}
